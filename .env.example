# Runtime. Use APP_ENV=staging with NODE_ENV=production for staging builds.
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL / Redis
DATABASE_URL=postgresql://temuclient:temuclient@localhost:5433/temuclient?schema=public
REDIS_URL=redis://localhost:6380
RATE_LIMIT_FAIL_OPEN=true

# Private object storage. Production requires S3_PROVIDER=s3 and every S3 value.
S3_PROVIDER=mock
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
STORAGE_SIGNING_SECRET=replace-only-for-local-mock-signing

# Transactional email. "log" records metadata only and never prints token/body.
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@temuclient.local
RESEND_API_KEY=

# Subscription pricing starts free. Enable paid plans only after the price and
# Midtrans merchant account have formal approval. QRIS invoices are one-time
# dynamic charges for each subscription period (not success-fee settlement).
BILLING_PROVIDER=sandbox
PAID_SUBSCRIPTIONS_ENABLED=false
BILLING_WEBHOOK_SECRET=replace-with-a-webhook-secret
PRO_MONTHLY_PRICE_IDR=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Analytics / error reporting
ANALYTICS_PROVIDER=database
ANALYTICS_ENDPOINT=
ANALYTICS_WRITE_KEY=
ERROR_TRACKING_DSN=

# AI
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
