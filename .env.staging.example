NODE_ENV=production
APP_ENV=staging
APP_URL=https://staging.temuclient.example
AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

DATABASE_URL=postgresql://replace-with-managed-staging-postgres
REDIS_URL=rediss://replace-with-managed-staging-redis
RATE_LIMIT_FAIL_OPEN=false

S3_PROVIDER=s3
S3_ENDPOINT=https://replace-with-private-staging-object-storage
S3_REGION=replace-with-region
S3_BUCKET=replace-with-staging-bucket
S3_ACCESS_KEY_ID=replace-with-staging-access-key
S3_SECRET_ACCESS_KEY=replace-with-staging-secret-key
S3_FORCE_PATH_STYLE=false
STORAGE_SIGNING_SECRET=replace-with-a-unique-staging-signing-secret

EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@staging.temuclient.example
RESEND_API_KEY=replace-with-staging-email-api-key

BILLING_PROVIDER=sandbox
BILLING_WEBHOOK_SECRET=replace-with-a-unique-staging-webhook-secret
STRIPE_SECRET_KEY=

ANALYTICS_PROVIDER=database
ANALYTICS_ENDPOINT=
ANALYTICS_WRITE_KEY=
ERROR_TRACKING_DSN=replace-with-staging-error-tracking-dsn

AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
