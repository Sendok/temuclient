NODE_ENV: "production"
APP_ENV: "staging"
APP_URL: "https://replace-with-exact-cloud-run-origin"
RATE_LIMIT_FAIL_OPEN: "false"

# Staging-safe adapters. Replace storage and email before formal production.
S3_PROVIDER: "mock"
EMAIL_PROVIDER: "log"
EMAIL_FROM: "noreply@temuclient.local"

BILLING_PROVIDER: "sandbox"
PAID_SUBSCRIPTIONS_ENABLED: "false"
MIDTRANS_IS_PRODUCTION: "false"

ANALYTICS_PROVIDER: "database"
AI_PROVIDER: "gemini"
GEMINI_MODEL: "gemini-2.5-flash"
