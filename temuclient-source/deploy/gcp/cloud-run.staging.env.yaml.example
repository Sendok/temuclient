NODE_ENV: "production"
APP_ENV: "staging"
APP_URL: "https://staging.temuclient.example"
RATE_LIMIT_FAIL_OPEN: "false"

S3_PROVIDER: "s3"
S3_ENDPOINT: "https://storage.googleapis.com"
S3_REGION: "asia-southeast2"
S3_BUCKET: "replace-with-private-staging-bucket"
S3_FORCE_PATH_STYLE: "true"

EMAIL_PROVIDER: "resend"
EMAIL_FROM: "noreply@staging.temuclient.example"

BILLING_PROVIDER: "sandbox"
PAID_SUBSCRIPTIONS_ENABLED: "false"
MIDTRANS_IS_PRODUCTION: "false"

ANALYTICS_PROVIDER: "database"
AI_PROVIDER: "deterministic"
OPENAI_MODEL: "gpt-5.6-luna"

